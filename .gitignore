# Dependencies
node_modules/
server/node_modules/

# Environment and config files
client/invoicer_config.json
client/invoicer_config-local.json
client/leedz_config.json
client/js/parser/anthropic-api-key.txt
server/mcp/mcp_server_config.json
server/mcp/mcp_server.log
CLAUDE.md
server/STATUS.txt

# API Keys and Secrets - NEVER COMMIT THESE
**/api-key*
**/anthropic-api-key*
**/*api*key*
**/*secret*
**/*token*
**/*password*
**/config*.json
**/.*key
**/.*secret
**/.*token
**/.env*
**/credentials*
**/auth*
sk-ant-*
sk-*
claude-*

# OS generated files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.lock

# Build outputs
dist/
build/
.fake
client/leedz-chrome-ext.zip
server/leedz-server-win-x64.zip
server/mcp/leedz-mcp.zip
# master deployable artifact (built by build_all.bat, uploaded to S3)
leedz-desktop-win-x64.zip
server/tray/bin/
server/tray/obj/
server/dist-pkg/**/*.exe
server/dist-pkg/**/*.dll

# Private keys / secrets not caught by the patterns above
KEY_FILE/
client/LLM_KEY.json
*.pem

# Business identity - contains real contact info + bank details. Track
# client/DOCS/VALUE_PROP.template.md instead (blank, section names only).
client/DOCS/VALUE_PROP.md
client/DOCS/VALUE_PROP.backup-*.md

# Server config - contains an absolute local DB path + the Square appSecret.
# Track server/server_config.template.json instead (placeholders only).
server/server_config.json
server/server_config.backup-*.json
server/dist-pkg/**/server_config.json

# Databases and data exports - never commit real client data
*.sqlite
*.sqlite-journal
*.sqlite.backup*
*.sqlite.migrating.tmp*
server/data/
server/exports/

# Local stash of real/informed config (VALUE_PROP.md, LLM_KEY.json,
# leedz_config.json, server_config.json) used by rebuild_and_restore.bat to
# repopulate a fresh build/ - same secrets class as the individual ignores
# above, just parked in one folder instead.
client/TMP/
server/TMP/
# Root doc archive - stale planning notes moved out of DOCS/ (2026-07-24)
/TMP/
