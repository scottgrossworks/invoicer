<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>img\icon.ico</ApplicationIcon>
    <AssemblyName>TheLeedz</AssemblyName>
    <!-- Bump on rebuild when Smart App Control blocks a build: a new version
         string changes the binary hash, forcing a fresh cloud-reputation
         verdict instead of the cached block. -->
    <Version>1.1.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="img\icon.ico" />
  </ItemGroup>

</Project>